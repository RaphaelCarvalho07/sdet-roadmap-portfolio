{
  "name": "sdet-mobile-appium",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.31.4",
    "@wdio/cli": "^9.31.4",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.46.1",
    "appium-uiautomator2-driver": "^8.5.0",
    "expect-webdriverio": "^6.0.9"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "emulator:start": "android emulator start medium_phone",
    "emulator:stop": "adb emu kill",
    "test": "wdio run ./wdio.conf.ts",
    "test:swipe": "wdio run ./wdio.conf.ts --spec test/specs/swipe.spec.ts",
    "test:login": "wdio run ./wdio.conf.ts --spec test/specs/test.e2e.ts",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  }
}
